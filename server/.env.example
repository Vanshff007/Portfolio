# Copy to .env for local development. On Render, set these in the dashboard instead.

# Required for the AI chat. Get a free key at https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Optional: pin a model instead of the gemini-flash-latest alias
GEMINI_MODEL=

# Sites allowed to call this API (comma-separated)
ALLOWED_ORIGINS=https://vanshff007.github.io,https://portfolio-8una.onrender.com,http://localhost:5500,http://127.0.0.1:5500

# LeetCode username for /api/leetcode
LEETCODE_USER=idgaf_vansh

# Optional: Spotify "now playing". See README for how to get the refresh token.
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
SPOTIFY_REFRESH_TOKEN=
